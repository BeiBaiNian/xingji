#define AppVersion "0.5.1"
#ifndef ReleaseDir
#define ReleaseDir "..\build\windows\x64\runner\Release"
#endif
; Release output directory. tool\build.ps1 passes /DDistDir=<resolved dist root>.
#ifndef DistDir
#define DistDir "..\dist"
#endif

[Setup]
AppId={{23962D21-4BFA-4EC3-BF0D-4B169EF21B80}
AppName=星记
AppVersion={#AppVersion}
AppPublisher=星记
AppComments=个人加密备忘录
DefaultDirName={localappdata}\Programs\XingJi
DefaultGroupName=星记
DisableProgramGroupPage=yes
PrivilegesRequired=lowest
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=10.0.22000
UninstallDisplayIcon={app}\xingji.exe
SetupIconFile=..\windows\runner\resources\app_icon.ico
OutputDir={#DistDir}
OutputBaseFilename=XingJi-{#AppVersion}-Windows-x64-Setup
Compression=lzma2/ultra64
SolidCompression=yes
WizardStyle=modern
CloseApplications=yes
RestartApplications=no
SetupLogging=yes
UninstallDisplayName=星记 · 私人加密备忘录
VersionInfoDescription=星记 Windows 安装程序
VersionInfoProductName=星记
VersionInfoVersion=0.5.1.9
VersionInfoProductVersion={#AppVersion}

[Languages]
Name: "chinesesimplified"; MessagesFile: "compiler:Languages\ChineseSimplified.isl"

[Tasks]
Name: "desktopicon"; Description: "创建桌面快捷方式"; GroupDescription: "快捷方式："

[Files]
; The native_assets.json at the bundle root is generated by Flutter's host tests.
Source: "{#ReleaseDir}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs; Excludes: "*.pdb,\native_assets.json"
Source: "..\docs\USER_GUIDE.md"; DestDir: "{app}\docs"; Flags: ignoreversion
Source: "..\docs\THIRD_PARTY_NOTICES.txt"; DestDir: "{app}\docs"; Flags: ignoreversion
Source: "..\LICENSE"; DestDir: "{app}\docs"; DestName: "LICENSE.txt"; Flags: ignoreversion
Source: "..\database\001_init.sql"; DestDir: "{app}\database"; Flags: ignoreversion
Source: "..\database\002_permanent_delete.sql"; DestDir: "{app}\database"; Flags: ignoreversion
Source: "..\database\README.md"; DestDir: "{app}\database"; Flags: ignoreversion

[InstallDelete]
Type: files; Name: "{app}\docs\RELEASE_NOTES.md"
Type: files; Name: "{app}\docs\TEST_REPORT.md"

[Icons]
Name: "{autoprograms}\星记"; Filename: "{app}\xingji.exe"; AppUserModelID: "XingJi.Desktop"; AppUserModelToastActivatorCLSID: "8D25B1F7-B60D-4633-8F3C-43EAEF890BD1"
Name: "{autodesktop}\星记"; Filename: "{app}\xingji.exe"; Tasks: desktopicon; AppUserModelID: "XingJi.Desktop"; AppUserModelToastActivatorCLSID: "8D25B1F7-B60D-4633-8F3C-43EAEF890BD1"

[Registry]
Root: HKCU; Subkey: "Software\Classes\xingji"; ValueType: string; ValueData: "URL:XingJi"; Flags: uninsdeletekey
Root: HKCU; Subkey: "Software\Classes\xingji"; ValueType: string; ValueName: "URL Protocol"; ValueData: ""
Root: HKCU; Subkey: "Software\Classes\xingji\DefaultIcon"; ValueType: string; ValueData: "{app}\xingji.exe,0"
Root: HKCU; Subkey: "Software\Classes\xingji\shell\open\command"; ValueType: string; ValueData: """{app}\xingji.exe"" ""%1"""
Root: HKCU; Subkey: "Software\Classes\AppUserModelId\XingJi.Desktop"; ValueType: string; ValueName: "DisplayName"; ValueData: "星记"; Flags: uninsdeletekey
Root: HKCU; Subkey: "Software\Classes\AppUserModelId\XingJi.Desktop"; ValueType: string; ValueName: "IconUri"; ValueData: "{app}\xingji.exe"
Root: HKCU; Subkey: "Software\Classes\AppUserModelId\XingJi.Desktop"; ValueType: string; ValueName: "CustomActivator"; ValueData: "{{8D25B1F7-B60D-4633-8F3C-43EAEF890BD1}"

[Run]
Filename: "{app}\xingji.exe"; Description: "启动星记"; Flags: nowait postinstall skipifsilent

[UninstallRun]
Filename: "{app}\xingji.exe"; Parameters: "--uninstall-cleanup"; Flags: runhidden waituntilterminated; RunOnceId: "RemoveXingJiNotifications"

[Code]
const
  ProbeKey = 'Software\Classes\XingJi.SetupProbe.23962D21';

function InitializeSetup: Boolean;
begin
  { Check the exact per-user registration area before copying any files.
    Development workspaces can label executables Low Integrity, including
    manually launched installers. Do not modify Windows security settings. }
  Result := RegWriteStringValue(HKCU, ProbeKey, 'AccessCheck', '1');
  if Result then
  begin
    RegDeleteValue(HKCU, ProbeKey, 'AccessCheck');
    RegDeleteKeyIfEmpty(HKCU, ProbeKey);
  end
  else
  begin
    Log('XingJi preflight: current-user notification registration is not writable.');
    SuppressibleMsgBox(
      '当前启动位置限制了安装程序的权限，无法登记 Windows 提醒。' + #13#10 + #13#10 +
      '请将星记 ZIP 发布包解压到你的“下载”文件夹，再运行解压后的安装程序。' + #13#10 +
      '请勿直接从开发项目目录或 ZIP 内运行。若仍失败，请保留安装日志以便检查。' + #13#10 + #13#10 +
      '本次尚未安装或修改你的备忘录资料。', mbError, MB_OK, IDOK);
  end;
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
  if CurUninstallStep = usUninstall then
    RegDeleteValue(HKCU, 'Software\Microsoft\Windows\CurrentVersion\Run', 'XingJi');
end;

