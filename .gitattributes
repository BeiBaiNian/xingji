# Normalize text files to LF in the repository and keep scripts usable on
# Windows checkouts. Binary assets stay untouched.
* text=auto eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.ico binary
*.jar binary
*.p12 binary
*.jks binary
*.keystore binary
*.apk binary
*.exe binary
*.dll binary
*.so binary

# Generated third-party license dump: exact bytes matter, no line-ending churn.
docs/THIRD_PARTY_NOTICES.txt -text
