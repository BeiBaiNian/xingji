/android/app/release
/android/key.properties
*.jks
*.p12
*.keystore

# Widget Preview related
.widget_preview/

# Local build, release and secret material. None of this is part of the source
# tree. Attach release binaries to the project's release page.
/dist/
/release/
/.tools/
/.signing/
/.test-data/
*.apk
*.aab
*.msi
*.exe
*.pdb
*.zip
/android/.kotlin/
/android/app/build/
/android/app/outputs/
/android/app/libs/*.jar

# Local vaults, exported backups and private database migrations
*.xingji
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
xingji_migration.sql

# Local credentials and signing passwords
/admin*.txt
*.env
.env.*
!.env.example
*.dpapi
*.pfx
*.key
*.pem

